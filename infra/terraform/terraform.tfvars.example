region             = "ap-south-1"
kubernetes_version = "1.37" # check: aws eks describe-cluster-versions --region ap-south-1

# Cheapest node that fits (~half the price of t3.medium). Switch to "t3.medium"
# if pods sit in Pending (out of memory or pod slots).
node_instance_type = "t3.small"

# Your SSO / console role, so you can kubectl and see workloads in the console.
admin_principal_arns = [
  # "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_AdministratorAccess_xxxx",
]

# Haiku 5.5 on the Bedrock Mantle endpoint makes the decision and writes the summary.
bedrock_model_id = "anthropic.claude-haiku-5-5"

min_confidence = 0.85
