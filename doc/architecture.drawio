or" target="deploy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="812"/><mxPoint x="500" y="349"/></Array></mxGeometry></mxCell><mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=11;fontColor=#999999;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.78;exitDx=0;exitDy=0;endArrow=open;" edge="1" parent="1" source="analyzer" target="secrets"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="470"/><mxPoint x="900" y="672"/></Array></mxGeometry></mxCell><mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=11;fontColor=#999999;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;endArrow=open;" edge="1" parent="1" source="executor" target="secrets"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eksd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#326CE5;strokeWidth=1;fontSize=11;fontColor=#326CE5;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;" edge="1" parent="1" source="eks" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Analyzer steps (④–⑧)&lt;/b&gt;: gather evidence in code → mask PII (emails, IPs, tokens, long numbers) → &lt;b&gt;Haiku 5.5&lt;/b&gt; structured decision → router + guardrails (button only if root_cause = bad_deploy, confidence ≥ 0.85 and code saw a new revision before the alarm) → Slack + Jira. &amp;nbsp;&lt;i&gt;Jev (TypeSafe) can replace the Haiku step later.&lt;/i&gt;&lt;br&gt;&lt;font color=#1A7F37&gt;━ ━ green dashed = read-only&lt;/font&gt; &amp;nbsp;&amp;nbsp; &lt;font color=#C62828&gt;━━ red = the only write path, runs only after a human approves&lt;/font&gt; &amp;nbsp;&amp;nbsp; &lt;font color=#999&gt;┅ secrets read&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=8;rounded=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="1450" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>